  entity: "team",
  kind: "basic",
  name: "BasicTeamFlow",
  step: [
    {
      m: {
        team_id: "team01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "team_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTeamFlow"
}